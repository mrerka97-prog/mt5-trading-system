# Энэ файлыг хуулж ".env" гэж нэрлээд утгуудаа бөглөнө үү.
# .env файлыг хэзээ ч бусадтай хуваалцахгүй, Git-д оруулахгүй.

# XM MT5 демо данс (XM-ээс ирсэн и-мэйлд байгаа)
MT5_PASSWORD=your_password
MT5_LOGIN=12345678
MT5_SERVER=XMGlobal-MT5 X

# MT5 терминалын зам (ихэвчлэн хоосон үлдээж болно)
MT5_PATH=

# Дараагийн шатуудад (P2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
